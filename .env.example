# Trackify environment template.
# Copy to `.env` and fill in real values.
# Never commit a real `.env` (already excluded by .gitignore).
#
# For local dev: run backend + frontend directly, use docker-compose.yml for DB only.
# For production: docker-compose -f docker-compose.prod.yml up -d --build

# ---------------------------------------------------------------------------
# Frontend (Vite SPA)
# ---------------------------------------------------------------------------
# Origin the SPA is served from in local dev. Used by the backend CORS config.
FRONTEND_ORIGIN=http://localhost:5173
# Base URL the SPA uses to call the backend API.
VITE_API_BASE_URL=http://localhost:8080/api

# ---------------------------------------------------------------------------
# Backend (Spring Boot)
# ---------------------------------------------------------------------------
# Active Spring profile (e.g. local, prod).
SPRING_PROFILES_ACTIVE=local
# HTTP port the backend listens on.
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL (business data + Spring Session JDBC)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trackify
POSTGRES_USER=trackify
POSTGRES_PASSWORD=changeme
# Full JDBC URL is derived from the values above; override if needed.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trackify
SPRING_DATASOURCE_USERNAME=trackify
SPRING_DATASOURCE_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Session (Spring Session JDBC)
# ---------------------------------------------------------------------------
# Where session state is stored. `jdbc` keeps sessions in PostgreSQL.
SPRING_SESSION_STORE_TYPE=jdbc
# Session inactivity timeout, ISO-8601 duration (e.g. PT30M, PT8H).
SERVER_SERVLET_SESSION_TIMEOUT=PT8H
# Session cookie hardening. Use `true` and `strict` in production over HTTPS.
SERVER_SERVLET_SESSION_COOKIE_NAME=TRACKIFY_SESSION
SERVER_SERVLET_SESSION_COOKIE_HTTP_ONLY=true
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Authentication (login/password via Spring Security)
# ---------------------------------------------------------------------------
# BCrypt strength used by the password encoder (10–12 is typical).
AUTH_PASSWORD_ENCODER_STRENGTH=10
# Minimum password length enforced at registration.
AUTH_PASSWORD_MIN_LENGTH=8
# Optional bootstrap admin seeded on first startup. Leave blank to disable.
AUTH_BOOTSTRAP_ADMIN_LOGIN=
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml only)
# ---------------------------------------------------------------------------
# Port nginx listens on on the host machine.
APP_PORT=80
# Public URL of the server (used for CORS config). Example: http://1.2.3.4
FRONTEND_ORIGIN=http://localhost
